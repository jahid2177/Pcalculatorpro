<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.PCalculator" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_gold</item>
        <item name="colorSecondaryVariant">@color/accent_gold</item>
        <item name="colorOnSecondary">@color/text_dark</item>
        <item name="android:statusBarColor">#080810</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="CalcButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="backgroundTint">@color/white</item>
        <item name="cornerRadius">24dp</item>
        <item name="strokeColor">@color/accent_gold</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="TableHeaderText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">4dp</item>
    </style>

    <!-- 🔥 FIXED DatePicker Theme -->
    <style name="PremiumDatePicker" parent="Theme.AppCompat.Light.Dialog">

        <!-- Accent -->
        <item name="colorPrimary">#7C6FFF</item>
        <item name="colorAccent">#7C6FFF</item>
        <item name="android:colorAccent">#7C6FFF</item>

        <!-- ✅ Ash Background -->
        <item name="android:windowBackground">#E0E0E0</item>
        <item name="android:colorBackground">#E0E0E0</item>

        <!-- ✅ Text Color -->
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:textColorSecondary">#555555</item>

        <!-- Buttons style (backup, but not enough alone) -->
        <item name="buttonBarPositiveButtonStyle">@style/PremiumDatePickerButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/PremiumDatePickerButton</item>

    </style>

    <!-- Button style -->
    <style name="PremiumDatePickerButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">#000000</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="LabelText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">#6B7280</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="StatBox" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">#1E1B40</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="android:layout_width">88dp</item>
        <item name="android:layout_height">88dp</item>
    </style>

    <style name="InfoCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">#13131F</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">0dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>

    <style name="IconBadge" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#7C6FFF</item>
    </style>

    <style name="StatNumber">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

</resources>