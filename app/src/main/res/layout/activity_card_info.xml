<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="#F0FDF4">

    <com.google.android.material.appbar.AppBarLayout
         android:layout_height="220dp"
         android:layout_width="match_parent"
         android:background="@android:color/transparent">

        <com.google.android.material.appbar.CollapsingToolbarLayout
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             app:contentScrim="#064E3B"
             app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <View
                 android:layout_height="match_parent"
                 android:layout_width="match_parent"
                 android:background="@drawable/premium_header_gradient" />

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:padding="30dp"
                 android:orientation="vertical"
                 android:layout_gravity="bottom">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="30sp"
                     android:fontFamily="sans-serif-black"
                     android:textColor="#FFFFFF"
                     android:text="Debit Card" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="14sp"
                     android:textColor="#B3FFFFFF"
                     android:letterSpacing="0.1"
                     android:text="Charges &amp; Benefits" />

            </LinearLayout>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
         android:layout_height="match_parent"
         android:layout_width="match_parent"
         app:layout_behavior="@string/appbar_scrolling_view_behavior"
         android:layout_marginTop="-30dp">

        <GridLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:background="@drawable/bg_main_content_round"
             android:padding="12dp"
             android:id="@+id/debitGrid"
             android:columnCount="2">

            <include
                 layout="@layout/item_dashboard_premium"
                 android:layout_columnWeight="1"
                 android:id="@+id/btnDebitCardCharges" />

        </GridLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>