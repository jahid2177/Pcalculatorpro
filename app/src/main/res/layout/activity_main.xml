<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="#F0FDF4">

    <com.google.android.material.appbar.AppBarLayout
         android:layout_height="320dp"
         android:layout_width="match_parent"
         android:background="@android:color/transparent">

        <com.google.android.material.appbar.CollapsingToolbarLayout
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             app:contentScrim="#064E3B"
             app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <View
                 android:layout_height="match_parent"
                 android:layout_width="match_parent"
                 android:background="@drawable/premium_header_gradient" />

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:padding="30dp"
                 android:orientation="vertical"
                 android:layout_gravity="bottom">

                <ImageView
                     android:layout_height="90dp"
                     android:layout_width="90dp"
                     android:layout_marginBottom="16dp"
                     android:src="@drawable/app_logo"
                     android:scaleType="centerInside"
                     android:contentDescription="App Logo" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="34sp"
                     android:fontFamily="sans-serif-black"
                     android:textColor="#FFFFFF"
                     android:text="Pcalculator Pro" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="16sp"
                     android:textColor="#B3FFFFFF"
                     android:letterSpacing="0.1"
                     android:text="Smart Financial Solutions" />

            </LinearLayout>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
         android:layout_height="match_parent"
         android:layout_width="match_parent"
         app:layout_behavior="@string/appbar_scrolling_view_behavior"
         android:layout_marginTop="-30dp">

        <GridLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:background="@drawable/bg_main_content_round"
             android:padding="12dp"
             android:id="@+id/mainGrid"
             android:columnCount="2">

            <include
                 layout="@layout/item_dashboard_premium"
                 android:layout_columnWeight="1"
                 android:id="@+id/card1" />

            <include
                 layout="@layout/item_dashboard_premium"
                 android:layout_columnWeight="1"
                 android:id="@+id/card2" />

            <include
                 layout="@layout/item_dashboard_premium"
                 android:layout_columnWeight="1"
                 android:id="@+id/card3" />

            <include
                 layout="@layout/item_dashboard_premium"
                 android:layout_columnWeight="1"
                 android:id="@+id/card4" />

            <include
                 layout="@layout/item_dashboard_premium"
                 android:layout_columnWeight="1"
                 android:id="@+id/card5" />

            <include
                 layout="@layout/item_dashboard_premium"
                 android:layout_columnWeight="1"
                 android:id="@+id/card6" />

            <include
                 layout="@layout/item_dashboard_premium"
                 android:layout_columnWeight="1"
                 android:id="@+id/card7" />

            <include
                 layout="@layout/item_dashboard_premium"
                 android:layout_columnWeight="1"
                 android:id="@+id/card8" />

            <include
                 layout="@layout/item_dashboard_premium"
                 android:layout_columnWeight="1"
                 android:id="@+id/card9" />

            <include
                 layout="@layout/item_dashboard_premium"
                 android:layout_columnWeight="1"
                 android:id="@+id/card10" />

            <include
                 layout="@layout/item_dashboard_premium"
                 android:layout_columnWeight="1"
                 android:id="@+id/card11" />

            <include
                 layout="@layout/item_dashboard_premium"
                 android:layout_columnWeight="1"
                 android:id="@+id/card12" />

        </GridLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>