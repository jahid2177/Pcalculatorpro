<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111">

    <!-- ── MAIN ViewPager2 ────────────────────────────────── -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpPdfPages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical" />

    <!-- ── Loading ────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#111111"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:indeterminateTint="#415A77" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:text="Loading PDF..." />

    </LinearLayout>

    <!-- ── TOP TOOLBAR ────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutToolbar"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="28dp"
        android:background="@drawable/bg_pdf_toolbar">

        <!-- Back button -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="←"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="0dp" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvPdfTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#AA000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="PDF Viewer" />

        <!-- Page chip -->
        <TextView
            android:id="@+id/tvPageChip"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_page_chip"
            android:text="1 / 1" />

        <!-- Share button — custom vector icon, always visible -->
        <ImageView
            android:id="@+id/btnShare"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:src="@drawable/ic_share"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Share PDF" />

    </LinearLayout>

    <!-- ── BOTTOM BAR ─────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_pdf_bottom_bar"
        android:paddingTop="24dp"
        android:paddingBottom="20dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Thumbnail strip -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvThumbnails"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:clipToPadding="false"
            android:layout_marginBottom="12dp" />

        <!-- Prev / SeekBar / Next -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnPrev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="‹"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_zoom_btn"
                android:padding="0dp" />

            <SeekBar
                android:id="@+id/seekPage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:progressTint="#415A77"
                android:thumbTint="#E0E1DD" />

            <Button
                android:id="@+id/btnNext"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="›"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_zoom_btn"
                android:padding="0dp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
